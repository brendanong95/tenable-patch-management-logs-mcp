# Copy to .env and adjust. Never commit .env.
#
# Log sources to analyse, as name=path pairs separated by semicolons. A path can be
# a folder (local or UNC), a single log file, or a .zip / .tar.gz bundle.
#   SaaS server logs:  Admin Portal > gear icon > Logs > Download All Server Logs (.zip)
#   On-prem server:    C:\Program Files\Tenable\PatchServer\logs  (or \\tpm01\c$\...)
#   Client logs:       C:\Program Files\Tenable\PatchClient\logs, a collected bundle,
#                      or a file requested from the server (e.g. 13_adaptiva.log)
# TPM_LOG_SOURCES=saas-server=C:\cases\acme\logs.zip;clients=C:\cases\acme\TPM-Logs-20260917

# saas | onprem | auto. With auto (the default) each source is classified from its
# own logs, and the evidence is shown by check_log_sources.
# TPM_DEPLOYMENT=auto

# Also pick up TPM logs installed on this machine (%ADAPTIVASERVER%, %ADAPTIVACLIENT%,
# %windir%\AdaptivaSetupLogs, /opt/tenable/patchclient/logs). Default: true
# TPM_AUTO_DISCOVER=true

# Where sources added with add_log_source, extracted bundles and recorded baselines
# are kept. Defaults to data/ in the project root; created automatically.
# TPM_MCP_DATA_DIR=./data

# The zone each source or device writes its logs in, as name=zone pairs. Keys match a
# source name first, then a device name, then '*'. Zones: IANA names (Asia/Singapore),
# fixed offsets (+08:00), UTC, or local (this machine). Only needed when logs come from
# machines in different zones - TPM timestamps carry no zone of their own.
# TPM_LOG_TIMEZONES=saas-server=UTC;WS-BAD07=Asia/Singapore;*=UTC

# The zone every result is shown in. Defaults to UTC once TPM_LOG_TIMEZONES is set;
# leave both unset to see timestamps exactly as written, which is the default.
# TPM_DISPLAY_TIMEZONE=Asia/Singapore

# Your own known issues, noise and PatchDeploymentResult meanings: a .json/.yaml file, a
# folder of them, or several paths separated by ';'. See examples/known_issues.example.json.
# Defaults to known_issues.json in the data dir when it exists.
# TPM_KNOWLEDGE_FILE=./data/known_issues.json
